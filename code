# Each record = [size, bedrooms, age]
X = [
    [1000, 2, 10],
    [1500, 3, 5],
    [1800, 4, 2],
    [2400, 4, 1],
    [3000, 5, 0]
]

# Target prices in $1000s
Y = [200, 300, 330, 400, 500]
# Training data
X = [
    [1000, 2, 10],
    [1500, 3, 5],
    [1800, 4, 2],
    [2400, 4, 1],
    [3000, 5, 0]
]

Y = [200, 300, 330, 400, 500]

# Step 1: Compute means
def mean(values):
    return sum(values) / len(values)

# Step 2: Compute coefficients for multiple features
def calculate_coefficients(X, Y):
    n = len(X[0])  # number of features
    m = [0] * n
    b = 0

    x_means = [mean([row[i] for row in X]) for i in range(n)]
    y_mean = mean(Y)

    for j in range(n):
        numerator = sum((X[i][j] - x_means[j]) * (Y[i] - y_mean) for i in range(len(X)))
        denominator = sum((X[i][j] - x_means[j]) ** 2 for i in range(len(X)))
        m[j] = numerator / denominator

    # Intercept b
    b = y_mean - sum(m[j] * x_means[j] for j in range(n))
    return m, b

# Step 3: Prediction
def predict(X, m, b):
    return [sum(m[j] * x[i][j] for j in range(len(m))) + b for i in range(len(X))]

# Step 4: Mean squared error
def mean_squared_error(y_true, y_pred):
    return sum((y_true[i] - y_pred[i]) ** 2 for i in range(len(y_true))) / len(y_true)

# Calculate model
m, b = calculate_coefficients(X, Y)
predicted = predict(X, m, b)
mse = mean_squared_error(Y, predicted)

# Output model
print("Model Coefficients:", m)
print("Intercept (b):", round(b, 2))
print("Predicted Prices:", predicted)
print("Mean Squared Error:", round(mse, 2))

# Test on a new house: [size, bedrooms, age]
new_house = [2000, 3, 5]
predicted_price = sum(m[j] * new_house[j] for j in range(len(m))) + b
print(f"\nPredicted price for a {new_house[0]} sq.ft, {new_house[1]} bedroom, {new_house[2]} year-old house: ${predicted_price:.2f}k")
